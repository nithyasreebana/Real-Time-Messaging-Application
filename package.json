{
  "name": "realtime-messaging-platform",
  "version": "1.0.0",
  "description": "Full-stack real-time messaging platform built with MERN stack and Socket.IO",
  "scripts": {
    "server": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "server:test:api": "node server/tests/apiTest.js",
    "server:test:socket": "node server/tests/socketTest.js",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "install:all": "npm install --prefix server && npm install --prefix client"
  },
  "keywords": [
    "mern",
    "socket.io",
    "react",
    "nodejs",
    "express",
    "mongodb",
    "realtime-chat"
  ],
  "author": "",
  "license": "MIT"
}
